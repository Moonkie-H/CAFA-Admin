{
  "name": "cafa-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "npm run typecheck && vite build",
    "deploy": "npm run build && wrangler deploy",
    "set-password": "node scripts/set-password.mjs",
    "media": "node scripts/media-delivery.mjs",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p test/tsconfig.json --noEmit",
    "types:worker": "wrangler types worker-configuration.d.ts --env-interface CloudflareBindings --include-runtime false"
  },
  "dependencies": {
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.11"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20260823.1",
    "@eslint/js": "^9.17.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.14.0",
    "typescript": "^5",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.7",
    "vitest": "^4.1.11",
    "wrangler": "^4.120.0"
  }
}
